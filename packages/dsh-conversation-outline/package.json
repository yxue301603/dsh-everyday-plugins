{
  "name": "dsh-conversation-outline",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness 原生插件：搜索用户提问，跳转原文并保存阅读位置。",
  "license": "MIT",
  "author": "yxue301603",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test src/*.test.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxue301603/dsh-conversation-outline.git"
  },
  "homepage": "https://github.com/yxue301603/dsh-conversation-outline#readme",
  "bugs": {
    "url": "https://github.com/yxue301603/dsh-conversation-outline/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "productivity"
  ],
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
